{
  "_about": "账本清单唯一真源（spec.md 只引用不复述）。键集 = research-loop.json 的 ledgers/owners 键集。owner 值域与豁免规则见 writes.json；行结构见 rows.json。",
  "_read_classes": {
    "query-only": "只经 ledger.py query 拿最小视图，禁整文件读进上下文",
    "md-full": "md 定稿件：允许整读或按条目切片（给人读的）",
    "direct": "小 json 单件：直读",
    "sliced": "大体量：脚本切片或派读手 subagent（roles.reader_model）"
  },
  "ledgers": {
    "principles":    {"default_path": "METHOD.md",                      "format": "md-table", "owner": "idea",           "read": "md-full",    "cap": null},
    "story":         {"default_path": "ops/story.jsonl",                "format": "jsonl",    "owner": "idea",           "read": "query-only", "cap": 1000,
                      "active": "status=active"},
    "timeline":      {"default_path": "TIMELINE.md",                    "format": "md",       "owner": "idea",           "read": "md-full",    "cap": null},
    "literature":    {"default_path": "KNOWLEDGE_MAP.md",               "format": "md",       "owner": "idea",           "read": "md-full",    "cap": null},
    "specs":         {"default_path": ".scratch/",                      "format": "md",       "owner": "deploy",         "read": "md-full",    "cap": null},
    "issues":        {"default_path": ".scratch/*/issues/",             "format": "md",       "owner": "deploy",         "read": "md-full",    "cap": null},
    "decisions":     {"default_path": "ops/decisions.jsonl",            "format": "jsonl",    "owner": "per-kind",       "read": "query-only", "cap": 1000,
                      "active": "kind=grant 且 status=decided 且未过期未被 superseded（=§5 有效授权视图），或被任何 decision_refs/affects/grant_ref/decision_ref/superseded_by 指向的行（被引用的永不归档；抉择账没有未决态——悬案归待决账，R5）"},
    "blocked":       {"default_path": "ops/blocked.jsonl",              "format": "jsonl",    "owner": "per-transition", "read": "query-only", "cap": 500,
                      "active": "status∈{open, answered}"},
    "feedback":      {"default_path": "ops/feedback.jsonl",             "format": "jsonl",    "owner": "shared-append",  "read": "query-only", "cap": 500,
                      "active": "建议条按最新 review 行合并后为 pending；suggestion 与指向它的全部 review 行永远同批归档"},
    "launch_orders": {"default_path": "ops/launch_orders/",             "format": "json",     "owner": "deploy",         "read": "direct",     "cap": null},
    "batch_reports": {"default_path": "plans/",                         "format": "md",       "owner": "deploy",         "read": "md-full",    "cap": null},
    "codemap":       {"default_path": "MAP.md",                         "format": "md",       "owner": "deploy",         "read": "md-full",    "cap": null},
    "schemas":       {"default_path": "ops/schemas/",                   "format": "json",     "owner": "deploy",         "read": "direct",     "cap": null},
    "runs_schema":   {"default_path": "ops/schemas/runs.schema.json",   "format": "json",     "owner": "deploy",         "read": "direct",     "cap": null},
    "error_classes": {"default_path": "ops/error_classes.json",         "format": "json",     "owner": "deploy",         "read": "direct",     "cap": null},
    "datasets":      {"default_path": "DATA.md",                        "format": "md",       "owner": "deploy",         "read": "md-full",    "cap": null},
    "runs":          {"default_path": "ops/runs.jsonl",                 "format": "jsonl",    "owner": "per-row-type",   "read": "query-only", "cap": null,
                      "active": "无活跃行概念：不轮转，cap 只许 null；query runs 必须带过滤（--batch/--run/--since/--metric 至少其一），无过滤拒绝返回全表——读全量走渲染产物"},
    "jobs":          {"default_path": "ops/jobs.json",                  "format": "json",     "owner": "run",            "read": "sliced",     "cap": null},
    "cluster_state": {"default_path": "ops/cluster_state.md",           "format": "md",       "owner": "run",            "read": "md-full",    "cap": null,
                      "_note": "new1 覆盖为 ops/gpu_state.md；无集群设施的工程该键留空"},
    "runmeta":       {"default_path": "<artifact_dir>/RUNMETA.json",    "format": "json",     "owner": "run",            "read": "direct",     "cap": null},
    "raw_data":      {"default_path": "<raw_data_roots>/**",            "format": "raw",      "owner": "run",            "read": "sliced",     "cap": null},
    "reports":       {"default_path": "reports/",                      "format": "md",       "owner": "oversight",      "read": "md-full",    "cap": null}
  },
  "optional_ledgers": {
    "runs_legacy":   {"default_path": "ops/runs.legacy.jsonl",          "format": "jsonl",    "owner": "frozen",         "read": "query-only", "cap": null,
                      "_note": "仅在 freeze-legacy 挂接迁移后存在（writes.json 维护动作）；任何写入拒"}
  },
  "_cap_rules": [
    "cap 即 research-loop.json 的 ledger_caps 默认值：null = 不轮转；键必须是 ledgers 键的子集且只许 jsonl 账；runs 与 runs_legacy 只许 null",
    "md 账不轮转、不设体量上限：整理由写权层会话或用户看着办（v2 裁员：md_size_caps 机制删除）"
  ]
}
