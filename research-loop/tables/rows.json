      "bad-metrics"
    ]
  },
  "story_row": {
    "_note": "故事账一行 = 一条主张。",
    "primary_key": [
      "claim_id"
    ],
    "required": [
      "claim_id",
      "claim",
      "evidence_runs",
      "baseline_runs",
      "candidate_runs",
      "selection_rule",
      "derivation_command",
      "principle_id",
      "role",
      "decided_by",
      "date",
      "status",
      "schema_version"
    ],
    "additionalProperties": false,
    "properties": {
      "claim_id": {
        "type": "string",
        "_note": "S 前缀自增"
      },
      "claim": {
        "type": "string",
        "_note": "一句话主张"
      },
      "evidence_runs": {
        "type": "array",
        "items": {
          "type": "string",
          "$ref_to": "runs.run_id"
        },
        "_note": "[run_id]"
      },
      "baseline_runs": {
        "type": "array",
        "items": {
          "type": "string",
          "$ref_to": "runs.run_id"
        },
        "_note": "[run_id]"
      },
      "candidate_runs": {
        "type": "array",
        "items": {
          "type": "string",
          "$ref_to": "runs.run_id"
        },
        "_note": "[run_id]"
      },
      "metric_names": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        },
        "_note": "[metric_name]（可空）——本 claim 的口径锚点，regression_check 按它加各 run 行的 filter 同口径重比；空则该 claim 不参与回归比对"
      },
      "selection_rule": {
        "type": "string",
        "_note": "怎么从候选里挑的"
      },
      "derivation_command": {
        "type": "string",
        "_note": "派生量的复算命令（R4）"
      },
      "principle_id": {
        "type": "string",
        "$ref_to": "principles.principle_id",
        "_note": "P00x"
      },
      "role": {
        "$enum": "story.role"
      },
      "decided_by": {
        "type": "string",
        "const": "user",
        "_note": "user"
      },
      "date": {
        "type": "string",
        "_note": "YYYY-MM-DD"
      },
      "status": {
        "$enum": "story.status"
      },
      "retired_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "retired_date": {
        "type": [
          "string",
          "null"
        ]
      },
      "retired_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "superseded_by": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "story.claim_id"
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "schema_version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "conditional": [],
    "_write_check": "所有被引 run_id 必须存在于 runs.jsonl 且 status=ok 且非 quick 行（§2.6）；metric_names 非空时，每个值必须在被引 run 的 runs 行里存在"
  },
  "decisions_row": {
    "_note": "抉择账一行 = 一次拍板或一次授权。",
    "primary_key": [
      "decision_id"
    ],
    "required": [
      "decision_id",
      "kind",
      "question",
      "reason",
      "authorized_by",
      "affects",
      "decided_by",
      "raised_at",
      "decided_at",
      "status",
      "schema_version"
    ],
    "additionalProperties": false,
    "properties": {
      "decision_id": {
        "type": "string",
        "_note": "D 前缀自增"
      },
      "kind": {
        "$enum": "decisions.kind"
      },
      "where": {
        "type": [
          "string",
          "null"
        ],
        "_note": "文件路径|spec条目|工单号（kind=grant 可空）"
      },
      "question": {
        "type": "string",
        "_note": "抉择点或授权的事项类别"
      },
      "options": {
        "type": [
          "array",
          "null"
        ],
        "_note": "[...]（grant 可空）"
      },
      "chosen": {
        "type": [
          "string",
          "null"
        ],
        "_note": "可 grep 的具体值（grant 可空）"
      },
      "reason": {
        "type": "string",
        "_note": "..."
      },
      "authorized_by": {
        "type": "string",
        "_note": "用户原话 | discussed | grant:D00x | spec-standing-gpu-1h"
      },
      "scope": {
        "type": [
          "object",
          "null"
        ],
        "_note": "{desc, path_globs[], expires_at: ISO|null}——kind=grant 必须结构化填全"
      },
      "principle_ref": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "principles.principle_id",
        "_note": "P00x|null"
      },
      "affects": {
        "type": "array",
        "items": {
          "type": "string",
          "$ref_to": [
            "specs.item_id",
            "issues.issue_id",
            "runs.run_id"
          ]
        },
        "_note": "[spec条目/工单/run_id]——多目标联合类型，判别靠 id 前缀与命名规则（spec 条目 item_id、工单号、run_id 按工程命名规则）"
      },
      "blocked_ref": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "blocked.blocked_id",
        "_note": "B00x|null（r5-choice 机械拼装的 decision 必填，回指触发它的 blocked 行；重跑查重键）"
      },
      "decided_by": {
        "$enum": "decisions.decided_by"
      },
      "raised_at": {
        "type": "string",
        "_note": "ISO秒级"
      },
      "decided_at": {
        "type": "string",
        "_note": "ISO秒级"
      },
      "status": {
        "$enum": "decisions.status"
      },
      "superseded_by": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "decisions.decision_id"
      },
      "withdrawn_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "withdrawn_reason": {
        "type": [
          "string",
          "null"
        ],
        "_note": "撤销时必填用户原话"
      },
      "schema_version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "conditional": [
      {
        "when": {
          "field": "kind",
          "op": "eq",
          "value": "decision"
        },
        "require": [
          "where",
          "options",
          "chosen"
        ],
        "_note": "where/options/chosen 三处『（kind=grant 可空）』『（grant 可空）』的机器形态"
      },
      {
        "when": {
          "field": "kind",
          "op": "eq",
          "value": "grant"
        },
        "require": [
          "scope"
        ],
        "_note": "kind=grant 必须结构化填全 {desc, path_globs[], expires_at}"
      },
      {
        "when": {
          "field": "status",
          "op": "eq",
          "value": "withdrawn"
        },
        "require": [
          "withdrawn_reason"
        ],
        "_note": "withdrawn_reason 的『撤销时必填用户原话』的机器形态"
      }
    ],
    "_grant_view": "有效授权视图 = kind=grant 且 status=decided 且未过期且无 superseded_by",
    "_notes": {
      "blocked_ref": "r5-choice 机械拼装路径（writes.json r5_choice_assembly）必填 blocked_ref。行内没有判别字段（decisions.kind 值域只有 decision|grant，r5-choice 是 blocked.kind），schema 判不出来，由 ledger.py 的拼装写入口强制并按它查重"
    }
  },
  "blocked_row": {
    "_note": "待决账一行 = 一个卡住的问题。",
    "primary_key": [
      "blocked_id"
    ],
    "required": [
      "blocked_id",
      "from_layer",
      "to_layer",
      "kind",
      "ref",
      "question",
      "evidence",
      "raised_at",
      "status",
      "schema_version"
    ],
    "additionalProperties": false,
    "properties": {
      "blocked_id": {
        "type": "string",
        "_note": "B 前缀自增"
      },
      "from_layer": {
        "$enum": "blocked.from_layer"
      },
      "to_layer": {
        "$enum": "blocked.to_layer"
      },
      "kind": {
        "$enum": "blocked.kind"
      },
      "ref": {
        "type": "string",
        "$ref_to": [
          "specs.item_id",
          "issues.issue_id",
          "runs.run_id",
          "blocked.blocked_id"
        ],
        "_note": "spec条目/工单/run_id/blocked_id（撤销重开时指旧条）——多目标联合类型，判别靠 id 前缀与命名规则（B 前缀即回指旧待决条）"
      },
      "question": {
        "type": "string",
        "_note": "卡在哪、缺什么"
      },
      "where": {
        "type": [
          "string",
          "null"
        ],
        "_note": "kind=r5-choice 必填"
      },
      "options": {
        "type": [
          "array",
          "null"
        ],
        "_note": "kind=r5-choice 必填"
      },
      "evidence": {
        "type": "array",
        "_note": "[日志路径, 已试动作]"
      },
      "raised_at": {
        "type": "string",
        "_note": "ISO秒级"
      },
      "status": {
        "$enum": "blocked.status"
      },
      "answer": {
        "type": [
          "string",
          "null"
        ]
      },
      "answered_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "answered_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "grant_ref": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "decisions.decision_id",
        "_note": "D00x|null（answered_by≠user 的 r5-choice 必填）"
      },
      "decision_ref": {
        "type": [
          "string",
          "null"
        ],
        "$ref_to": "decisions.decision_id",
        "_note": "D00x|null"
      },
      "schema_version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "conditional": [
      {
        "when": {
          "field": "kind",
          "op": "eq",
          "value": "r5-choice"
        },
        "require": [
          "where",
          "options"
        ],
        "_note": "where 与 options 的『kind=r5-choice 必填』的机器形态"
      },
      {
        "when": [
          {
            "field": "kind",
            "op": "eq",
            "value": "r5-choice"
          },
          {
            "field": "status",
            "op": "eq",
            "value": "answered"
          },
          {
            "field": "answered_by",
            "op": "neq",
            "value": "user"
          }
        ],
        "require": [
          "grant_ref"
        ],
        "_note": "grant_ref 的『answered_by≠user 的 r5-choice 必填』的机器形态——第三个 status 子句是 T05 自查补的：answered_by 在 open 态恒为 null，null neq 'user' 也成立，没有 status 子句会让这条规则在 open 时就误触发（把从没答过的行也当成『被非 user 答过』），r5-choice 的行永远开不出来。加 status=answered 把『答复』限定成真的发生过一次 answer 动作，跟本字段 _note 顶头那句『answered_by≠user 的 r5-choice 必填』的『答』字本身对齐"
      }
    ]
  },
