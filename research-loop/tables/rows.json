  "runs_row_normal": {
    "_note": "数字账的普通行：一次逻辑实验的一个指标。",
    "primary_key": [
      "run_id",
      "metric_name",
      "filter"
    ],
    "required": [
      "run_id",
      "status",
      "output_dir",
      "runmeta_path",
      "metric_name",
      "value",
      "n",
      "filter",
      "seed",
      "dataset_version",
      "batch_id",
      "arm",
      "quick",
      "principle_id",
      "commit",
      "elapsed_s",
      "gpu_count",
      "recorded_at",
      "schema_version"
    ],
    "additionalProperties": false,
    "properties": {
      "run_id": {
        "type": "string"
      },
      "status": {
        "$enum": "runs.status"
      },
      "output_dir": {
        "type": "string"
      },
      "runmeta_path": {
        "type": "string"
      },
      "metric_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "value": {
        "type": [
          "number",
          "string",
          "null"
        ]
      },
      "n": {
        "type": [
          "integer",
          "null"
        ],
        "_note": "分母"
      },
      "filter": {
        "type": [
          "string",
          "null"
        ],
        "_note": "记账脚本从发射单透传（部署层填、可空），运行层不判语义"
      },
      "seed": {
        "type": "integer"
      },
      "dataset_version": {
        "type": "string"
      },
      "batch_id": {
        "type": "string"
      },
      "arm": {
        "$enum": "runs.arm",
        "_note": "记账脚本从发射单透传（部署层填、可空），运行层不判语义"
      },
      "quick": {
        "type": "boolean",
        "_note": "记账脚本从发射单透传（部署层填、可空），运行层不判语义"
      },
      "principle_id": {
        "type": "null",
        "_note": "普通行一律 null（非 null 即判据缩减行）"
      },
      "commit": {
        "type": "null",
        "_note": "普通行 null——普通行的 commit 在 RUNMETA"
      },
      "elapsed_s": {
        "type": [
          "integer",
          "null"
        ]
      },
      "gpu_count": {
        "type": [
          "integer",
          "null"
        ],
        "_note": "资源类字段——动作集与 retry 策略字段、资源类字段由 adapter 与工程定义，plugin 只定形状；非算力集群工程可空、可不实现"
      },
      "recorded_at": {
        "type": "string",
        "_note": "ISO秒级，两个入账脚本自动打、不许手填；query --since 按它过滤"
      },
      "schema_version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "conditional": [
      {
        "when": {
          "field": "status",
          "op": "neq",
          "value": "ok"
        },
        "allow_null": [
          "metric_name",
          "value",
          "n"
        ],
        "_note": "status≠ok：metric_name/value/n 允许 null"
      }
    ],
    "_dup_rule": "同主键重复入账拒（两个入账脚本都跨档查存在性）——重试补记不产生第二份数字",
    "_run_level_fields": "status/output_dir/runmeta_path/seed/dataset_version/batch_id/arm/quick/commit/elapsed_s/gpu_count 是 run 级事实，同 run_id 各行必须逐字相同",
    "_notes": {
      "主键": "主键 (run_id, metric_name, filter)；metric_name 为 null 的行（status≠ok 的失败行）每 run_id 至多一行",
      "多指标": "一次实验多指标 = 同 run_id 多行，一行一指标；只出一个指标就是一行",
      "写入粒度": "记账脚本一次把该 run 的全部行写完，不分次追加",
