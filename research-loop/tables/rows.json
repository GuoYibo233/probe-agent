      "grant"
    ],
    "decisions.status": [
      "decided",
      "withdrawn"
    ],
    "decisions.decided_by": [
      "user",
      "agent"
    ],
    "story.status": [
      "active",
      "retired"
    ],
    "story.role": [
      "主结果",
      "消融",
      "反例",
      "动机"
    ],
    "feedback.kind": [
      "suggestion",
      "review"
    ],
    "feedback.verdict": [
      "accepted",
      "rejected"
    ],
    "runs.status": [
      "ok",
      "failed",
      "oom",
      "timeout",
      "empty-output",
      "killed",
      "partial"
    ],
    "runs.arm": [
      "实验组",
      "对照组"
    ],
    "principles.status": [
      "【现状】",
      "【已定要改】",
      "【想法待定】",
      "【已撤销】"
    ],
    "inspection.verdict": [
