#!/usr/bin/env python3
"""bin/rl: the only door into the nine ledgers (03 L9; 05).

Dispatch only. `rl <group> <sub> ...` is looked up in tables/commands.json; the handler
lives in scripts/rl_cmds/<group>.py as `cmd_<sub>(args, ctx)`. Global flags (05 L7-25,
L104-123): --json, --as-gyb, --quote, --force, --reason. Exit codes from
tables/exit_codes.json; every non-zero exit prints the reason kind on the first stderr
line (03 L226).

Step 3a delivers this dispatcher with no handlers, so every command exits 1 `internal`
with "not implemented"; step 3b fills scripts/rl_cmds/.
"""

import importlib
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))

import rl_lib  # noqa: E402

GLOBAL_FLAGS_WITH_VALUE = {"--quote", "--reason"}
GLOBAL_FLAGS_BOOL = {"--json", "--as-gyb", "--force"}


def split_global_flags(argv):
    """Pull the five global flags out of argv wherever they appear."""
    opts = {"json": False, "as_gyb": False, "force": False, "quote": None, "reason": None}
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in GLOBAL_FLAGS_BOOL:
            opts[a.lstrip("-").replace("-", "_")] = True
        elif a in GLOBAL_FLAGS_WITH_VALUE:
            if i + 1 >= len(argv):
                raise rl_lib.RLError("usage", f"{a} needs a value")
            opts[a.lstrip("-")] = argv[i + 1]
            i += 1
        elif a.startswith("--quote=") or a.startswith("--reason="):
            k, v = a[2:].split("=", 1)
            opts[k] = v
        else:
            rest.append(a)
        i += 1
    return opts, rest


def resolve_command(rest):
    """Match the longest command name in tables/commands.json against the argv head.

    Names are one word (`status`, `trace`, `init`, `inbox`, `reclaim`, `doctor`) or two
    (`handoff open`); doctor's flag forms (`doctor --ack`) are matched literally.
    """
    if not rest:
        raise rl_lib.RLError("usage", "no sub-command given", usage_hint())
    for n in (2, 1):
        name = " ".join(rest[:n])
        if name in rl_lib.COMMANDS:
            return name, rest[n:]
    head = rest[0]
    known = sorted({n.split(" ")[0] for n in rl_lib.COMMANDS})
    if head in known:
        subs = sorted(n for n in rl_lib.COMMANDS if n.startswith(head + " "))
        raise rl_lib.RLError("usage", f"unknown sub-command for {head}: {' '.join(rest[:2])!r}",
                             "known: " + ", ".join(subs))
    pend = [p["name"] for p in rl_lib.COMMANDS_TABLE.get("pending_commands", [])]
    if any(p.startswith(head + " ") or p == head for p in pend):
        raise rl_lib.RLError("usage", f"`rl {head}` is pending a ruling and not built",
                             "see tables/commands.json pending_commands")
    raise rl_lib.RLError("usage", f"unknown command {head!r}", "known groups: " + ", ".join(known))


def usage_hint():
    return "usage: rl <group> <sub> [args] [--json] [--as-gyb --quote Q] [--force --reason R]"


def main(argv):
    opts, rest = split_global_flags(argv)
    name, args = resolve_command(rest)
    spec = rl_lib.COMMANDS[name]
    group = spec["group"]
    sub = name.split(" ", 1)[1] if " " in name else "main"
    sub = sub.lstrip("-").replace("-", "_")
    try:
        module = importlib.import_module(f"rl_cmds.{group}")
        handler = getattr(module, f"cmd_{sub}")
    except (ModuleNotFoundError, AttributeError):
        raise rl_lib.RLError("internal", f"not implemented: rl {name}",
                             "build step 3b fills scripts/rl_cmds/")
    ctx = {"opts": opts, "command": name, "spec": spec}
    result = handler(args, ctx)
    if opts["json"]:
        print(json.dumps(result if result is not None else {"ok": True}, ensure_ascii=False))
    elif isinstance(result, str):
        print(result)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except rl_lib.RLError as err:
        sys.exit(err.emit("--json" in sys.argv))
    except Exception as err:  # noqa: BLE001 - any other failure is exit 1 internal (03 L220)
        sys.exit(rl_lib.RLError("internal", f"{type(err).__name__}: {err}").emit("--json" in sys.argv))
