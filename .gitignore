# new1 版本控制边界
#
# 原则：代码 / 笔记 / 统计数字 进库；虚拟环境 / 第三方仓库 / 实验原始数据 不进库。
# 原始数据靠 NFS 路径 + 各批次的 .md 出厂报告追溯，不靠 git。

# ── 虚拟环境（uv 管理，用 uv.lock 复原）
*-env/
.venv/
**/.venv/
envs/cuda-compat-13.0/

# ── 第三方仓库与 benchmark 套件（各自带 .git，用 clone 复原）
paper/acl-style-files/
related_work/
jacobian-lens/
envs/tau2-bench/
envs/appworld/
envs/tales/
envs/bfcl/

# ── envs/alfworld/ 是我们自建的（不是第三方 clone），只忽略三样：
#    venv（332M，uv.lock 复原）/ data（软链到 fig1_pilot 的 2.1G 数据）/ logs。
#    splits/ 是自己生成的题单，ALFWorld 官方不提供清单文件，必须入库才可复现。
envs/alfworld/venv/
envs/alfworld/data
envs/alfworld/logs/

# ── 大体积原始数据
fig1_pilot/alfworld_data/
traj_pipeline/data/

# ── 已搬 NFS 的目录软链（git 不穿软链，带尾斜杠或 /** 的规则匹配不到链本体，
#    必须裸名；目录将来变回实体也照样命中）
envs/bert_runs
fig1_pilot/alfworld_data
envs/toolhop
envs/stabletoolbench

# ── 回放执行缓存（exec_calls 的结果缓存，纯产物）
pipeline/inject/exec_cache/

# ── 实验产物目录：只保留 .md 报告，其余（轨迹 / 权重 / 中间文件）不入库
envs/runs/**
!envs/runs/**/
!envs/runs/**/*.md

envs/bert_data/**
!envs/bert_data/**/
!envs/bert_data/**/*.md

envs/bert_runs/**
!envs/bert_runs/**/
!envs/bert_runs/**/*.md

*/results/**
!*/results/**/
!*/results/**/*.md

# ── 日志与权重
logs/
*.log
*.out
*.pt
*.pth
*.safetensors
*.bin
*.feather
*.npy
*.npz

# ── LaTeX 编译中间产物（论文成品 PDF 也不入库，tex 源是唯一权威）
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# ── Python 杂物
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── 本地设置（.claude/skills 与 agents 是工程资产，要入库）
.claude/settings.local.json

# ── C3 任务对数据本体（种子 20260729 可逐字节重生成，stats.json 统计进库）
benchmark_design/*.jsonl

pipeline/data/**
!pipeline/data/**/
!pipeline/data/**/*.md
pipeline/runs/**
!pipeline/runs/**/
!pipeline/runs/**/*.md
# 注入回放的落盘(plan.jsonl/raw.jsonl 是原始轨迹级数据,单个 run 十几 MB);
# 只放 md 报告与 plan_config.json 进库,后者是口径记录、几百字节
pipeline/inject/runs/**
!pipeline/inject/runs/**/
!pipeline/inject/runs/**/*.md
!pipeline/inject/runs/**/plan_config.json
