# new1 version control boundary
#
# Principle: code / notes / statistics go into the repo; virtual envs / third-party repos / raw experiment data do not.
# Raw data is tracked via NFS paths and each batch's .md release report, not via git.

# venvs and clones live under envs/, reached through external/ (bare names: symlinks)
*-env/
.venv/
**/.venv/
external/appworld
external/probe-env
external/vllm-env

# third-party benchmark clones under envs/: each has its own .git, restored by clone
envs/appworld/
envs/tau2-bench/
envs/tales/
envs/bfcl/
envs/cuda-compat-13.0/

# the official ACL template, cloned under paper/ by the paper-write skill (its own .git);
# the skill is live, so this rule stays whether or not the directory is on disk today
paper/acl-style-files/

# envs/alfworld/ is ours: only the venv, the data symlink and the logs are ignored;
# splits/ is a self-generated task list and is tracked
envs/alfworld/venv/
envs/alfworld/data
envs/alfworld/logs/

# symlinks to directories that live on NFS (bare names, since git does not follow them)
envs/runs
envs/stabletoolbench
envs/toolhop

# the registry's lock (8.6); the rows and the rendered table are in git (tree line for jobs/)
jobs/runs.jsonl.lock

# outputs live on NFS and nothing under them is in git (iron rule; 6.3 names the root)

# python miscellany, logs, weights
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
logs/
*.log
*.out
*.pt
*.pth
*.safetensors
*.bin
*.npy
*.npz

# latexmk's intermediates, written beside the tex by the paper-write skill's build.sh
# (*.log and *.out above cover two more of them); the skill is live, so these rules stay
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# local settings only; .claude skills and agents are engineering assets and stay in the repo
.claude/settings.local.json
