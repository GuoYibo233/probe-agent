{
  // CPU debugger demo for the trainer; see demo/README.md.
  // None of the three configs touch the GPU: CUDA_VISIBLE_DEVICES is empty, --device cpu,
  // the model and data are fixtures built by demo/prepare.py (run the third config once first, or
  // `python3 run.py demo-prep`). The trainer being debugged is the real one,
  // pipeline/train/train_causal_share.py, not changed by a single character.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "demo: train cgen on CPU (tiny model)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/train/train_causal_share.py",
      "python": "${workspaceFolder}/cprobe-env/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // false = F11 can step all the way into transformers' Qwen3 forward pass; set to true if you only want to see the engineering code
      "justMyCode": false,
      "env": { "CUDA_VISIBLE_DEVICES": "" },
      "args": [
        "--mode", "cgen",
        "--base", "demo/tiny_qwen3",
        "--data", "demo/data",
        "--out", "demo/runs/cgen",
        "--device", "cpu",
        "--epochs", "2",
        "--eval-per-epoch", "2",
        "--log-every", "1",
        "--tok-budget", "768",
        "--gen-eval", "4",
        "--gen-bs", "2",
        "--align-events", "3",
        // The trainer refuses to train again into an --out that already has train_log.jsonl; the demo needs to run repeatedly, so this allows it
        "--force"
      ]
    },
    {
      "name": "demo: train cparam on CPU (tiny model)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline/train/train_causal_share.py",
      "python": "${workspaceFolder}/cprobe-env/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "CUDA_VISIBLE_DEVICES": "" },
      "args": [
        "--mode", "cparam",
        "--base", "demo/tiny_qwen3",
        "--data", "demo/data",
        "--out", "demo/runs/cparam",
        "--device", "cpu",
        "--epochs", "2",
        "--eval-per-epoch", "2",
        "--log-every", "1",
        "--tok-budget", "768",
        "--gen-eval", "4",
        "--gen-bs", "2",
        "--align-events", "3",
        "--force"
      ]
    },
    {
      "name": "demo: prepare fixtures (data + tiny model)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo/prepare.py",
      "python": "${workspaceFolder}/cprobe-env/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "CUDA_VISIBLE_DEVICES": "" }
    }
  ]
}
